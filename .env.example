# SMTP config (legacy — pre NEX-48, kept for reference if rollback to Express origin is needed)
EMAIL_SERVER_HOST=smtp.tudominio.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=usuario_smtp
EMAIL_SERVER_PASSWORD=clave_smtp
EMAIL_FROM=contact@nextwrld.com

# Contact protection — Turnstile (public build config, Vite exposes only VITE_* to the browser)
# No secrets here. Secret va en .dev.vars / wrangler secret.
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=

# Worker vars (non-secret) — see wrangler.toml [vars] and .dev.vars.example for secrets
# CONTACT_ANTIBOT_ENABLED, CONTACT_RATE_LIMIT_ENABLED, RATE_LIMIT_MAX, etc. se configuran en wrangler.toml
